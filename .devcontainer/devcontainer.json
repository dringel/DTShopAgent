{
  "name": "Digital Twin Lab",
  // Base image is STILL pinned BY DIGEST (audit 8.1) so every prebuild
  // and rebuild resolves to the same bytes — the digest now lives in
  // .devcontainer/Dockerfile, which additionally strips the stale Yarn
  // APT source that otherwise fails the desktop-lite Feature install and
  // drops the codespace into an Alpine recovery container. Re-resolve
  // the digest deliberately when bumping, never implicitly.
  "build": {
    "dockerfile": "Dockerfile",
    // no COPY in the Dockerfile, so the small .devcontainer dir is a
    // sufficient (and much faster) build context than the repo root
    "context": "."
  },
  "features": {
    // feature version pinned explicitly (was the floating major ':1')
    "ghcr.io/devcontainers/features/desktop-lite:1.2.10": {
      "password": "dtlab",
      "webPort": "6080",
      "vncPort": "5901"
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Lab Desktop (KEEP PRIVATE — password printed in setup log)",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "onCreateCommand": "bash .devcontainer/setup.sh onCreate",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
