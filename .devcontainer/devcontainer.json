{
  "name": "Digital Twin Lab",
  // Base image pinned BY DIGEST (audit 8.1) so every prebuild and
  // rebuild resolves to the same bytes. The digest below was resolved
  // from tag mcr.microsoft.com/devcontainers/python:1-3.12-bookworm on
  // 2026-07-26; re-resolve deliberately when bumping, never implicitly.
  "image": "mcr.microsoft.com/devcontainers/python@sha256:7876580dc67fd460fd962f004cbeb480027e9bbc0657096f1087db11f9eaff39",
  "features": {
    // feature version pinned explicitly (was the floating major ':1')
    "ghcr.io/devcontainers/features/desktop-lite:1.2.10": {
      "password": "dtlab",
      "webPort": "6080",
      "vncPort": "5901"
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Lab Desktop (KEEP PRIVATE — password printed in setup log)",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "onCreateCommand": "bash .devcontainer/setup.sh onCreate",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
