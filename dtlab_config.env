# dtlab_config.env — single source of truth for constants shared across the
# kit's shell and Python tools. Shell scripts source this file; Python tools
# parse it line-by-line (see tools/pack_evidence.py::load_config). Values are
# single-quoted so regexes survive shell sourcing unmangled.
#
# Provisioning copies this file to ~/dtlab/dtlab_config.env. Every consumer
# carries a matching fallback default so a missing file degrades gracefully,
# but the file is the authority — change constants HERE, nowhere else.
# (build_form.gs cannot read this file; its ID pattern must be kept in sync
# by hand — it is marked with a comment.)

# Item count of the course questionnaire (must equal the row count of
# questionnaire/questionnaire_items.csv; tests/test_instrument_lockstep.py
# enforces the lockstep).
DTLAB_EXPECTED_ITEMS='115'

# Course pseudonym pattern (Python/grep -E compatible).
DTLAB_ID_PATTERN='DT[0-9]{4}-[0-9]{3}'

# The ONE browser profile shared by the human session (dtlab-shop) and the
# agent session (relative to $HOME).
DTLAB_BROWSER_PROFILE='.dtlab-browser-profile'

# CDP port the browser is launched with, and that Hermes /browser connect
# attaches to. Verify against current Hermes docs at the T-21 dry run.
DTLAB_CDP_PORT='9222'

# ---- design factors (plan of record: within-student 2x2, see
# COURSE_PLAN_1WEEK.md and research_protocol.md §1) ----
# Questionnaire-ablation factor: ON. The agent runs the SAME task set
# with persona grounding (questionnaire + purchase profile) and ablated
# grounding (purchase profile only), counterbalanced per day
# (P_FIRST/NP_FIRST from the LMS list). With the factor on, dtlab-start
# walks FOUR runs: runs 1-2 on day 1, runs 3-4 on day 2.
DTLAB_PERSONA_FACTOR='1'

# Model tier is WITHIN-SUBJECT BY DAY: runs 1-2 use the day-1 tier
# (economy / Haiku class, Thursday), runs 3-4 the day-2 tier (frontier /
# Sonnet class, Friday). dtlab-start records the tier per run
# (runs/runN/tier.txt); the packer prefers those per-run files.
# Record the exact model IDs for the manifest via DTLAB_MODEL_ID_DAY1
# and DTLAB_MODEL_ID_DAY2 (fallback: DTLAB_MODEL_ID) until Hermes
# exposes the model it used. (The legacy per-student DTLAB_TIER_FACTOR
# prompt is retired.)
DTLAB_DAY1_TIER='economy'
DTLAB_DAY2_TIER='frontier'
