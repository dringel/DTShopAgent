# dtlab_config.env — single source of truth for constants shared across the
# kit's shell and Python tools. Shell scripts source this file; Python tools
# parse it line-by-line (see tools/pack_evidence.py::load_config). Values are
# single-quoted so regexes survive shell sourcing unmangled.
#
# Provisioning copies this file to ~/dtlab/dtlab_config.env. Every consumer
# carries a matching fallback default so a missing file degrades gracefully,
# but the file is the authority — change constants HERE, nowhere else.
# (build_form.gs cannot read this file; its ID pattern must be kept in sync
# by hand — it is marked with a comment.)

# Item count of the course questionnaire (must equal the row count of
# questionnaire/questionnaire_items.csv; tests/test_instrument_lockstep.py
# enforces the lockstep). Two items (PR02, PR08 — make_persona.py
# AGENT_HIDDEN_ITEMS) are research-only and never rendered into the
# agent-visible persona; the pre-flight gate checks the rendered count.
DTLAB_EXPECTED_ITEMS='115'

# Course pseudonym pattern (Python/grep -E compatible).
DTLAB_ID_PATTERN='DT[0-9]{4}-[0-9]{3}'

# The ONE browser profile shared by the human session (dtlab-shop) and the
# agent session (relative to $HOME). It lives under the persistent lab
# root (~/dtlab is that root, or a symlink to it on Codespaces), so the
# logged-in amazon.in session survives a container rebuild; the basename
# is non-hidden for snap-confinement compatibility on the VM route.
DTLAB_BROWSER_PROFILE='dtlab/browser-profile'

# CDP port the browser is launched with, and that Hermes /browser connect
# attaches to. Verify against current Hermes docs at the T-21 dry run.
DTLAB_CDP_PORT='9222'

# ---- design factors (plan of record: within-student 2x2, see
# COURSE_PLAN_1WEEK.md and research_protocol.md §1) ----
# Questionnaire-ablation factor: ON. The agent runs the SAME task set
# with persona grounding (questionnaire + purchase profile) and ablated
# grounding (purchase profile only), counterbalanced per day
# (P_FIRST/NP_FIRST from the LMS list). With the factor on, dtlab-start
# walks FOUR runs: runs 1-2 on day 1, runs 3-4 on day 2.
DTLAB_PERSONA_FACTOR='1'

# Model tier is WITHIN-SUBJECT, COUNTERBALANCED ACROSS DAYS per student:
# each student's day-1 and day-2 tiers come from the counterbalance
# sheet (tier_day1/tier_day2 — half the section runs economy first,
# half frontier first, orthogonal to the grounding orders). dtlab-start
# resolves the tier from the sheet (typed entry demoted to
# confirmation; fail closed without either) and records it per run
# (runs/runN/tier.txt); the packer prefers those per-run files. The
# DTLAB_DAY1_TIER/DTLAB_DAY2_TIER values below are LEGACY: parsed
# harmlessly for one release, used only as the sandbox fallback. (The
# per-student DTLAB_TIER_FACTOR prompt is retired.)
DTLAB_DAY1_TIER='economy'
DTLAB_DAY2_TIER='frontier'

# ---- model pinning (audit 2.2 / 8.x) ----
# The EXACT model IDs the two tiers run. dtlab-start writes them into
# each run's generated Hermes config ($HERMES_HOME/config.yaml, from
# provisioning/hermes_config.template.yaml) and re-verifies the
# generated file before launch. PIN-AT-DRYRUN is a FAIL-CLOSED
# placeholder: the launcher refuses to start any run until the real IDs
# are pinned here (TA_ONBOARDING.md > T-21 trial-run work items #2).
# DTLAB_ALLOW_UNPINNED=1 escapes for throwaway test builds.
DTLAB_PROVIDER='anthropic'
DTLAB_MODEL_ECONOMY='claude-haiku-4-5-20251001'
DTLAB_MODEL_FRONTIER='claude-sonnet-5'

# Freeze-time kit commit (audit 8.1): set by the instructor when the kit
# is frozen (short hash from `git rev-parse --short HEAD`). dtlab-start
# compares it against the commit recorded in ~/dtlab/kit_version.txt at
# build time — a mismatch means the codespace was built from a STALE
# prebuild and must be rebuilt. Blank = check skipped with a note
# (pre-freeze builds).
DTLAB_EXPECTED_COMMIT=''
